# Application
APP_NAME=AI Research OS
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002
CORS_ORIGINS=http://localhost:2008,http://127.0.0.1:2008

# Frontend (optional — default uses /backend proxy)
# NEXT_PUBLIC_API_URL=/backend
# BACKEND_URL=http://localhost:8002

# LLM (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=research
POSTGRES_PASSWORD=research
POSTGRES_DB=research_os

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=research

# arXiv
ARXIV_MAX_RESULTS=10

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# AutoResearch (autoresearch-style experiment loop)
AUTORESEARCH_MAX_ITERATIONS=12
AUTORESEARCH_TRAIN_BUDGET_SECONDS=300

# Experiment training: mock | nanochat
EXPERIMENT_TRAINING_MODE=mock
EXPERIMENT_USE_GPU=false
EXPERIMENT_USE_DOCKER=false
EXPERIMENT_DOCKER_IMAGE=research-ai-experiment-sandbox:latest
EXPERIMENT_DOCKER_MEMORY=4g
